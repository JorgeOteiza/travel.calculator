# Flask
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=reemplaza-por-una-clave-segura
SQLALCHEMY_DATABASE_URI=postgresql://usuario:contrasena@localhost:5432/travelcalculator
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Servicios usados por el backend
OPENWEATHERMAP_API_KEY=tu-clave-openweathermap
ELEVATION_PROVIDER=open_meteo
PAID_GOOGLE_APIS_ENABLED=False
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles

# Variables públicas incluidas en el frontend por Vite
VITE_BACKEND_URL=http://localhost:5000
VITE_GOOGLE_MAPS_API_KEY=tu-clave-google-maps-restringida-por-dominio
VITE_MAP_ID=tu-map-id
