# Flask
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=reemplaza-por-una-clave-segura
SQLALCHEMY_DATABASE_URI=postgresql://usuario:contrasena@localhost:5432/travelcalculator
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Servicios usados por el backend
OPENWEATHERMAP_API_KEY=tu-clave-openweathermap
ELEVATION_PROVIDER=open_meteo
PAID_GOOGLE_APIS_ENABLED=False

# Sign in with Google -- Client ID público (no es un secreto). Si se deja
# vacío, las rutas /api/google-nonce y /api/google-login responden 503 y
# el botón de Google no se muestra en el frontend; el acceso por
# contraseña sigue funcionando sin esta variable.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Variables públicas incluidas en el frontend por Vite
VITE_BACKEND_URL=http://localhost:5000
VITE_GOOGLE_MAPS_API_KEY=tu-clave-google-maps-restringida-por-dominio
VITE_MAP_ID=tu-map-id
# Mismo valor que GOOGLE_CLIENT_ID de arriba (el Client ID es público y es
# el mismo en frontend y backend).
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
